rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function getUserRole() {
      return isAuth()
        ? (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            : null)
        : null;
    }

    function isSuperAdmin() {
      return isAuth() && getUserRole() == 'super-admin';
    }

    function isPhotographerOwner(photographerId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/photographers/$(photographerId)) &&
        get(/databases/$(database)/documents/photographers/$(photographerId)).data.ownerUid == request.auth.uid;
    }

    function isPublicGallery(galleryId) {
      return exists(/databases/$(database)/documents/galleries/$(galleryId)) &&
        (
          !('isPrivate' in get(/databases/$(database)/documents/galleries/$(galleryId)).data)
          || get(/databases/$(database)/documents/galleries/$(galleryId)).data.isPrivate == false
        );
    }

    match /system/{docId} {
      allow read: if isSuperAdmin();
      allow write: if !exists(/databases/$(database)/documents/system/initial_seed) || isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'photographer';
      allow update: if isSuperAdmin() || (
        isOwner(uid) && request.resource.data.role == resource.data.role
      );
      allow delete: if false;
    }

    match /photographers/{photographerId} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAuth() && (
        (resource.data.ownerUid == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid)
        || isSuperAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /galleries/{galleryId} {
      allow read: if !('isPrivate' in resource.data)
        || resource.data.isPrivate == false
        || isSuperAdmin()
        || (isAuth() && isPhotographerOwner(resource.data.photographerId));

      allow create: if isAuth() && isPhotographerOwner(request.resource.data.photographerId);
      allow update: if isAuth() && isPhotographerOwner(resource.data.photographerId);
      allow delete: if isAuth() && (isPhotographerOwner(resource.data.photographerId) || isSuperAdmin());
    }

    match /mediaAssets/{mediaId} {
      allow read: if isPublicGallery(resource.data.galleryId)
        || isSuperAdmin()
        || (isAuth() && isPhotographerOwner(resource.data.photographerId));

      allow create: if isAuth() && isPhotographerOwner(request.resource.data.photographerId);
      allow update: if isAuth() && isPhotographerOwner(resource.data.photographerId);
      allow delete: if isAuth() && (isPhotographerOwner(resource.data.photographerId) || isSuperAdmin());
    }

    match /portfolioSections/{sectionId} {
      allow read: if !('isPrivate' in resource.data)
        || resource.data.isPrivate == false
        || isSuperAdmin()
        || (isAuth() && isPhotographerOwner(resource.data.photographerId));

      allow create: if isAuth() && isPhotographerOwner(request.resource.data.photographerId);
      allow update: if isAuth() && isPhotographerOwner(resource.data.photographerId);
      allow delete: if isAuth() && (isPhotographerOwner(resource.data.photographerId) || isSuperAdmin());
    }

    match /portfolioAssets/{assetId} {
      allow read: if exists(/databases/$(database)/documents/portfolioSections/$(resource.data.sectionId))
        && (
          !('isPrivate' in get(/databases/$(database)/documents/portfolioSections/$(resource.data.sectionId)).data)
          || get(/databases/$(database)/documents/portfolioSections/$(resource.data.sectionId)).data.isPrivate == false
          || isSuperAdmin()
          || (isAuth() && isPhotographerOwner(resource.data.photographerId))
        );

      allow create: if isAuth() && isPhotographerOwner(request.resource.data.photographerId);
      allow update: if isAuth() && isPhotographerOwner(resource.data.photographerId);
      allow delete: if isAuth() && (isPhotographerOwner(resource.data.photographerId) || isSuperAdmin());
    }
    match /leads/{leadId} {
      allow create: if request.resource.data.photographerId is string
        && request.resource.data.photographerSlug is string
        && request.resource.data.name is string
        && request.resource.data.status == 'new';

      allow read, update, delete: if isSuperAdmin()
        || (isAuth() && isPhotographerOwner(resource.data.photographerId));
    }

    match /affiliates/{affiliateId} {
      allow read: if isSuperAdmin() || isOwner(affiliateId);
      allow create, update, delete: if isSuperAdmin();
    }

    match /affiliate_codes/{codeId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /sales/{saleId} {
      allow read: if isSuperAdmin()
        || (isAuth() && resource.data.affiliateId == request.auth.uid);
      allow create, update, delete: if isSuperAdmin();
    }
    match /subscriptions/{subscriptionId} {
      allow read: if isAuth() && (isPhotographerOwner(resource.data.photographerId) || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /favorites/{favoriteId} {
      allow read: if true;
      allow create: if request.resource.data.clientToken != null
        && request.resource.data.mediaId != null;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }
  }
}

